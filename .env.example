# ============================================================================
# KPE Club Launcher — Build-Time Secret Configuration (.env)
# ============================================================================
# HOW TO USE:
#   1. Copy or rename this file to:  .env
#   2. Paste your Microsoft Azure App Registration "Application (client) ID" below.
#   3. Run build-win64.bat (or build-win32.bat).
#
# SECURITY:
#   - .env is listed in .gitignore so it is NEVER pushed to GitHub.
#   - .env is NEVER bundled inside the installer.
#   - At build time, installer\inject-client-id.ps1 reads KPE_CLIENT_ID from .env
#     and encodes it into SHA-256 XOR-masked byte shards (OBFUSCATED_CID) inside
#     MicrosoftAuth.java before Maven compiles.
# ============================================================================

KPE_CLIENT_ID=00000000-0000-0000-0000-000000000000
