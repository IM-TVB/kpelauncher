<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="site.kpeclub.launcher.ui.MainController"
            styleClass="root-pane">

    <!-- Left: sidebar with account block + nav -->
    <left>
        <VBox styleClass="sidebar" prefWidth="240" minWidth="240" maxWidth="240" spacing="4">

            <!-- Brand -->
            <VBox spacing="0">
                <padding><Insets top="20" right="18" bottom="6" left="18"/></padding>
                <Label text="KPE CLUB" styleClass="brand-title"/>
                <Label text="MINECRAFT LAUNCHER" styleClass="brand-sub"/>
            </VBox>

            <!-- Account block -->
            <VBox styleClass="account-block" spacing="2">
                <VBox.margin><Insets top="8" right="12" bottom="8" left="12"/></VBox.margin>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <StackPane styleClass="avatar-circle">
                        <Label text="?" styleClass="avatar-letter"/>
                    </StackPane>
                    <VBox spacing="1" HBox.hgrow="ALWAYS" minWidth="0">
                        <Label fx:id="accountLabel" text="Not signed in" styleClass="account-name" textOverrun="ELLIPSIS"/>
                        <Label fx:id="accountStatusLabel" text="offline" styleClass="account-status"/>
                    </VBox>
                </HBox>
            </VBox>

            <Separator styleClass="sidebar-separator"/>

            <!-- Nav -->
            <VBox styleClass="nav-list" spacing="2">
                <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
                <ToggleButton fx:id="navHomeButton" text="Home" styleClass="nav-item" visible="false" managed="false"/>
                <ToggleButton fx:id="navPlayButton" text="▶  Play" styleClass="nav-item" selected="true"/>
                <ToggleButton fx:id="navInstallationsButton" text="My Games" styleClass="nav-item"/>
                <ToggleButton fx:id="navModpacksButton" text="Modpacks" styleClass="nav-item"/>
                <ToggleButton fx:id="navBrowseModsButton" text="Mods" styleClass="nav-item"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <Separator styleClass="sidebar-separator"/>

            <VBox styleClass="nav-list" spacing="2">
                <padding><Insets top="10" right="10" bottom="14" left="10"/></padding>
                <ToggleButton fx:id="navWhatsNewButton" text="What's new" styleClass="nav-item" visible="false" managed="false"/>
                <ToggleButton fx:id="navSettingsButton" text="Settings" styleClass="nav-item"/>
                <Label text="v1.8.1" styleClass="version-label"/>
            </VBox>
        </VBox>
    </left>

    <!-- Center: hero banner + play controls, or settings panel -->
    <center>
        <StackPane minWidth="0" minHeight="0">

            <!-- ============ PLAY VIEW ============ -->
            <BorderPane fx:id="playView" minWidth="0" minHeight="0">

                <center>
                    <StackPane fx:id="heroBannerPane" styleClass="hero-banner"
                               minWidth="0" minHeight="0" prefWidth="200" prefHeight="200"
                               maxWidth="Infinity" maxHeight="Infinity">
                        <StackPane fx:id="heroBannerOverlay" styleClass="hero-banner-overlay"/>
                        <VBox alignment="CENTER" spacing="4" mouseTransparent="true">
                            <Label text="KPE CLUB" styleClass="hero-logo-text"/>
                            <Label text="Type your name, pick a version, press PLAY." styleClass="hero-tagline"/>
                        </VBox>
                    </StackPane>
                </center>

                <bottom>
                    <VBox styleClass="play-bar" minWidth="0">
                        <padding><Insets top="14" right="20" bottom="16" left="20"/></padding>
                        <VBox styleClass="play-card" spacing="12" minWidth="0">

                            <HBox spacing="14" alignment="BOTTOM_LEFT" minWidth="0">
                                <VBox spacing="5" HBox.hgrow="ALWAYS" prefWidth="240" minWidth="140">
                                    <Label text="1.  Your name" styleClass="step-label"/>
                                    <TextField fx:id="usernameField" promptText="Type any name, e.g. Steve"
                                               styleClass="res-field" minWidth="0" maxWidth="Infinity"
                                               prefHeight="40" minHeight="40" maxHeight="40"/>
                                </VBox>
                                <VBox spacing="5" HBox.hgrow="ALWAYS" prefWidth="240" minWidth="140">
                                    <Label text="2.  Minecraft version" styleClass="step-label"/>
                                    <ComboBox fx:id="versionComboBox" promptText="Choose version"
                                              styleClass="version-dropdown" minWidth="0" maxWidth="Infinity"
                                              prefHeight="40" minHeight="40" maxHeight="40"/>
                                </VBox>
                                <VBox spacing="5" prefWidth="210" minWidth="180" maxWidth="220">
                                    <Label text="3.  Start" styleClass="step-label"/>
                                    <Button fx:id="playButton" text="PLAY" styleClass="btn-play"
                                            maxWidth="Infinity" prefHeight="40" minHeight="40" maxHeight="40"/>
                                </VBox>
                            </HBox>

                            <HBox spacing="8" alignment="CENTER_LEFT" minWidth="0">
                                <ProgressBar fx:id="downloadProgress" prefWidth="220" minWidth="120" visible="false" managed="false"/>
                                <Label fx:id="progressDetailLabel" styleClass="status-label" minWidth="0" textOverrun="ELLIPSIS" visible="false" managed="false"/>
                                <Button fx:id="cancelButton" text="Cancel" styleClass="btn-outline-small" minWidth="64" visible="false" managed="false"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="statusLabel" styleClass="status-label" minWidth="0" textOverrun="ELLIPSIS" text="Type your name to start."/>
                            </HBox>

                            <TitledPane text="More options (Fabric, Microsoft login)" expanded="false" animated="false" styleClass="more-options">
                                <VBox spacing="10">
                                    <padding><Insets top="10" right="0" bottom="0" left="0"/></padding>
                                    <HBox spacing="10" alignment="CENTER_LEFT">
                                        <Label text="Mods (Fabric)" styleClass="field-label" minWidth="100"/>
                                        <ComboBox fx:id="modLoaderComboBox" prefWidth="140" minWidth="120" prefHeight="34" minHeight="34" maxHeight="34" styleClass="version-dropdown"/>
                                        <ComboBox fx:id="fabricLoaderVersionComboBox" prefWidth="180" minWidth="140" prefHeight="34" minHeight="34" maxHeight="34" styleClass="version-dropdown" visible="false" managed="false"/>
                                    </HBox>
                                    <HBox spacing="10" alignment="CENTER_LEFT">
                                        <Label text="Account" styleClass="field-label" minWidth="100"/>
                                        <Button fx:id="loginButton" text="Microsoft login (optional)" styleClass="btn-outline"/>
                                        <Button fx:id="refreshHomeButton" text="Refresh versions" styleClass="btn-outline-small"/>
                                    </HBox>
                                </VBox>
                            </TitledPane>
                        </VBox>
                    </VBox>
                </bottom>
            </BorderPane>

            <!-- ============ SETTINGS VIEW (launcher settings) ============ -->
            <ScrollPane fx:id="settingsView" visible="false" managed="false" fitToWidth="true" styleClass="installations-scroll">
                <VBox styleClass="settings-view" spacing="14" minWidth="0">
                    <padding><Insets top="24" right="28" bottom="24" left="28"/></padding>

                    <Label text="Settings" styleClass="section-heading"/>

                    <!-- Game -->
                    <VBox styleClass="card" spacing="12" minWidth="0">
                        <Label text="Game" styleClass="subsection-heading"/>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="Window size" styleClass="field-label" minWidth="110"/>
                            <TextField fx:id="widthField" prefWidth="86" minWidth="86" maxWidth="86" prefHeight="34" minHeight="34" maxHeight="34" text="1280" styleClass="res-field"/>
                            <Label text="x" styleClass="field-label"/>
                            <TextField fx:id="heightField" prefWidth="86" minWidth="86" maxWidth="86" prefHeight="34" minHeight="34" maxHeight="34" text="720" styleClass="res-field"/>
                        </HBox>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="Memory (RAM)" styleClass="field-label" minWidth="110"/>
                            <Slider fx:id="ramSlider" min="512" max="8192" blockIncrement="256" prefWidth="260" minWidth="140"/>
                            <Label fx:id="ramValueLabel" text="Auto" minWidth="64" styleClass="field-label"/>
                            <Button fx:id="ramAutoButton" text="Auto" minWidth="56" styleClass="btn-outline-small"/>
                        </HBox>
                        <Label fx:id="ramHintLabel" styleClass="card-hint" wrapText="true"/>
                        <CheckBox fx:id="keepOpenCheckBox" text="Keep the launcher open while the game is running" styleClass="settings-checkbox"/>
                    </VBox>

                    <!-- Performance -->
                    <VBox styleClass="card" spacing="10" minWidth="0">
                        <Label fx:id="performanceHeadingLabel" text="Performance &amp; Old PC Bypass" styleClass="subsection-heading"/>
                        <CheckBox fx:id="fpsBoostCheckBox" text="Boost FPS (smoother Java settings + high priority)" styleClass="settings-checkbox"/>
                        <CheckBox fx:id="driverBypassCheckBox" text="Bypass unsupported GPU driver (Old PC / Intel Q45 / GMA / HD Graphics)" styleClass="settings-checkbox"/>
                        <HBox spacing="8">
                            <Button fx:id="installFpsModsButton" text="Install FPS mods (Fabric)" styleClass="btn-outline"/>
                            <Button fx:id="lowGraphicsButton" text="Low graphics settings" styleClass="btn-outline"/>
                            <Button fx:id="importMesaButton" text="Download / Load Mesa3D" styleClass="btn-outline"/>
                        </HBox>
                        <Label fx:id="fpsHintLabel" text="Tip: Driver bypass automatically downloads and attaches the Mesa3D OpenGL software driver when PLAY is clicked so Minecraft 1.16.5 and 1.17+ run on old Intel Q45 / GMA / HD GPUs." styleClass="card-hint" wrapText="true"/>
                    </VBox>

                    <!-- Versions -->
                    <VBox styleClass="card" spacing="10" minWidth="0">
                        <Label text="Versions" styleClass="subsection-heading"/>
                        <CheckBox fx:id="showSnapshotsCheckBox" text="Show snapshots" styleClass="settings-checkbox"/>
                        <CheckBox fx:id="showOldVersionsCheckBox" text="Show old versions (Beta / Alpha)" styleClass="settings-checkbox"/>
                    </VBox>

                    <!-- Java -->
                    <VBox styleClass="card" spacing="10" minWidth="0">
                        <Label text="Java (advanced)" styleClass="subsection-heading"/>
                        <Label fx:id="systemInfoLabel" styleClass="card-hint" wrapText="true"/>
                        <HBox spacing="8" alignment="CENTER_LEFT" minWidth="0">
                            <TextField fx:id="javaPathField" promptText="Automatic (Mojang's Java for your PC)"
                                       styleClass="res-field" HBox.hgrow="ALWAYS" minWidth="0" maxWidth="Infinity"
                                       prefHeight="34" minHeight="34" maxHeight="34"/>
                            <Button fx:id="browseJavaButton" text="Browse..." minWidth="76" styleClass="btn-outline-small"/>
                            <Button fx:id="clearJavaButton" text="Auto" minWidth="56" styleClass="btn-outline-small"/>
                        </HBox>
                        <TextField fx:id="extraJvmField" promptText="Extra JVM arguments (optional)"
                                   styleClass="res-field" minWidth="0" maxWidth="Infinity"
                                   prefHeight="34" minHeight="34" maxHeight="34"/>
                        <Label text="Leave Java empty unless a version needs a special Java. A 32-bit Java is used if you pick one." styleClass="card-hint" wrapText="true"/>
                    </VBox>

                    <!-- Appearance -->
                    <VBox styleClass="card" spacing="10" minWidth="0">
                        <Label text="Appearance" styleClass="subsection-heading"/>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="Theme" styleClass="field-label" minWidth="110"/>
                            <ComboBox fx:id="themeComboBox" prefWidth="150" minWidth="150" prefHeight="34" minHeight="34" maxHeight="34" styleClass="version-dropdown"/>
                        </HBox>
                        <Label fx:id="wallpaperStatusLabel" text="Using default background." styleClass="hero-subtitle"/>
                        <HBox spacing="8">
                            <Button fx:id="changeWallpaperButton" text="Change Wallpaper" styleClass="btn-outline"/>
                            <Button fx:id="resetWallpaperButton" text="Reset to Default" styleClass="btn-outline-small"/>
                        </HBox>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="Brightness" styleClass="field-label" minWidth="110"/>
                            <Slider fx:id="bannerBrightnessSlider" min="0" max="1" prefWidth="220"/>
                        </HBox>
                    </VBox>

                    <!-- Launcher Updates -->
                    <VBox styleClass="card" spacing="10" minWidth="0">
                        <Label text="Launcher Updates (v1.8.1)" styleClass="subsection-heading"/>
                        <Label fx:id="updateStatusLabel" text="KPE Club Launcher v1.8.1 is installed. Running a newer Setup .exe or updating here keeps all settings, mods, and worlds." styleClass="card-hint" wrapText="true"/>
                        <HBox spacing="8">
                            <Button fx:id="checkUpdateButton" text="Check for Updates" styleClass="btn-outline"/>
                            <Button fx:id="applyLocalUpdateButton" text="Update from Setup .exe..." styleClass="btn-outline-small"/>
                        </HBox>
                    </VBox>

                    <!-- Uninstall -->
                    <VBox styleClass="card" spacing="10" minWidth="0">
                        <Label text="On Uninstall" styleClass="subsection-heading"/>
                        <Label text="Choose whether uninstalling also removes your saved settings (wallpaper, preferences)." styleClass="card-hint" wrapText="true"/>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <ComboBox fx:id="uninstallDataComboBox" prefWidth="230" minWidth="230" prefHeight="34" minHeight="34" maxHeight="34" styleClass="version-dropdown"/>
                        </HBox>
                    </VBox>
                </VBox>
            </ScrollPane>

            <!-- ============ INSTALLATIONS VIEW ============ -->
            <VBox fx:id="installationsView" visible="false" managed="false" styleClass="settings-view" spacing="10" minWidth="0">
                <padding><Insets top="24" right="28" bottom="24" left="28"/></padding>
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="Installations" styleClass="section-heading"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="refreshInstallationsButton" text="Refresh" styleClass="btn-outline-small"/>
                </HBox>
                <ScrollPane fx:id="installationsScrollPane" fitToWidth="true" styleClass="installations-scroll" VBox.vgrow="ALWAYS">
                    <VBox spacing="20" minWidth="0">
                        <VBox fx:id="installationsListBox" spacing="8"/>

                        <VBox spacing="6">
                            <Label text="Mods" styleClass="subsection-heading"/>
                            <VBox fx:id="modsListBox" spacing="8"/>
                        </VBox>

                        <VBox spacing="6">
                            <Label text="Resource Packs" styleClass="subsection-heading"/>
                            <VBox fx:id="resourcePacksListBox" spacing="8"/>
                        </VBox>
                    </VBox>
                </ScrollPane>
                <Label fx:id="installationsFolderLabel" styleClass="status-label"/>
            </VBox>

            <!-- ============ MODPACKS VIEW ============ -->
            <VBox fx:id="modpacksView" visible="false" managed="false" styleClass="settings-view" spacing="14" minWidth="0">
                <padding><Insets top="24" right="28" bottom="24" left="28"/></padding>
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="Modpacks" styleClass="section-heading"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="importModpackButton" text="Import .mrpack" styleClass="btn-outline"/>
                </HBox>
                <Label text="Modrinth (.mrpack) modpacks only, Fabric loader only, for now." styleClass="hero-subtitle"/>
                <ScrollPane fitToWidth="true" styleClass="installations-scroll" VBox.vgrow="ALWAYS">
                    <VBox fx:id="modpacksListBox" spacing="8"/>
                </ScrollPane>
                <ProgressBar fx:id="modpackImportProgress" prefWidth="400" visible="false" managed="false"/>
                <Label fx:id="modpackImportStatusLabel" styleClass="status-label"/>
            </VBox>

            <!-- ============ BROWSE MODS VIEW ============ -->
            <VBox fx:id="browseModsView" visible="false" managed="false" styleClass="settings-view" spacing="14" minWidth="0">
                <padding><Insets top="24" right="28" bottom="24" left="28"/></padding>
                <Label text="Mods" styleClass="section-heading"/>
                <Label fx:id="browseModsContextLabel" text="" styleClass="hero-subtitle"/>

                <HBox fx:id="modFabricBanner" styleClass="banner" spacing="12" alignment="CENTER_LEFT" visible="false" managed="false">
                    <Label text="Mods need Fabric. Turn it on and the launcher does the rest." styleClass="banner-text" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <Button fx:id="modFabricButton" text="Turn on Fabric" styleClass="btn-play-small"/>
                </HBox>

                <HBox spacing="8" alignment="CENTER_LEFT" minWidth="0">
                    <TextField fx:id="modSearchField" promptText="Search mods (for example: sodium, minimap)..."
                               styleClass="res-field" HBox.hgrow="ALWAYS" minWidth="0" maxWidth="Infinity"
                               prefHeight="36" minHeight="36" maxHeight="36"/>
                    <Button fx:id="modSearchButton" text="Search" minWidth="80" prefHeight="36" minHeight="36" maxHeight="36" styleClass="btn-play-small"/>
                </HBox>
                <HBox fx:id="modCategoryBox" spacing="8"/>
                <Label fx:id="modSearchStatusLabel" styleClass="status-label"/>

                <ScrollPane fitToWidth="true" styleClass="installations-scroll" VBox.vgrow="ALWAYS">
                    <VBox fx:id="modSearchResultsBox" spacing="10"/>
                </ScrollPane>
            </VBox>

        </StackPane>
    </center>

    <!-- Bottom: console/log bar -->
    <bottom>
        <HBox styleClass="console-bar" spacing="10" alignment="CENTER_LEFT" minWidth="0">
            <padding><Insets top="6" right="10" bottom="6" left="10"/></padding>
            <Label fx:id="consoleLabel" text="Ready." styleClass="console-text" minWidth="0" textOverrun="ELLIPSIS" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        </HBox>
    </bottom>

</BorderPane>
